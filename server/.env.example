# Firebase Project ID (must match lib/firebase_options.dart and android/app/google-services.json)
FIREBASE_PROJECT_ID=vanitytracker

# Network host binding
# 127.0.0.1: Local machine / emulator only (default)
# 0.0.0.0: Accessible across LAN for physical phone testing (WARNING: only use on trusted private Wi-Fi!)
HOST=127.0.0.1
PORT=8787

# Gmail credentials for sending invitation emails (Google App Password, NOT your main account password)
# Generated at https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
MAIL_FROM_NAME=Vanity Tracker

# Optional: Public web app address for the email invitation link button (e.g. https://your-project.web.app)
APP_URL=

# Optional: Additional allowed browser origins (comma separated)
ALLOWED_ORIGINS=
